# Copy to ~/.config/trading-research/search.env (chmod 600) or export in your shell.
# NEVER commit a real .env file.

# Optional CLI locations (otherwise resolved from PATH)
# LONGBRIDGE_BIN=/usr/local/bin/longbridge
# HERMES_BIN=/usr/local/bin/hermes
# AKSHARE_PYTHON=python3

# Longbridge / LongPort OpenAPI (paper/read-only recommended)
# LONGPORT_APP_KEY=
# LONGPORT_APP_SECRET=
# LONGPORT_ACCESS_TOKEN=

# Optional keyed web search (Doubao Global). Loaded only by multi_source_search allow-list.
# VOLC_DOUBAO_SEARCH_API_KEY=

# SEC EDGAR User-Agent identity (required by SEC fair-access policy)
# Used by scripts/us_company_evidence.py
# SEC_EDGAR_IDENTITY=Trading Research Bot research-bot@example.com
# (optional alias used by config docs)
# TRADING_RESEARCH_SEC_IDENTITY=Trading Research Bot research-bot@example.com

# OKX research modes: public | read_only | demo  (live is blocked by this skill)
# OKX_MODE=public
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=

# Hard deny for live trading in this skill (keep unset/false)
# TRADING_RESEARCH_ALLOW_LIVE=false

# Optional paths
# TRADING_RESEARCH_CONFIG=${HOME}/.config/trading-research/config.yaml
# TRADING_RESEARCH_STATE_DIR=${HOME}/.cache/trading-research/state
# TRADING_RESEARCH_SEC_CACHE_DIR=${HOME}/.cache/trading-research/sec-edgar
# TRADING_RESEARCH_SEARCH_ENV=${HOME}/.config/trading-research/search.env
